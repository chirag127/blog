---
/*
 * Sidebar — collapsible aside with a keyboard-friendly mobile drawer.
 *
 * Props:
 *   collapsible? (default true), position? 'left'|'right' (default 'left'),
 *   width? (default '240px')
 *
 * Slots: default (nav items), header, footer.
 * Desktop keeps the sidebar in flow; mobile uses the shared hidden checkbox
 * state so the bottom bar can open the same drawer without a React island.
 */
interface Props {
  collapsible?: boolean
  position?: 'left' | 'right'
  width?: string
}
const { collapsible = true, position = 'left', width = '240px' } = Astro.props
const hasHeader = Astro.slots.has('header')
const hasFooter = Astro.slots.has('footer')
const sidebarId = 'site-sidebar'
---
{collapsible && (
  <input type="checkbox" id="sb-toggle" class="sb-toggle" hidden aria-controls={sidebarId} />
)}
{collapsible && (
  <>
    <button
      type="button"
      class="sb-burger"
      data-sidebar-toggle
      aria-label="Open sidebar"
      aria-controls={sidebarId}
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>
    <button type="button" class="sb-scrim" data-sidebar-close aria-label="Close sidebar"></button>
  </>
)}
<aside
  id={sidebarId}
  class:list={["site-sidebar", `is-${position}`]}
  style={`--sb-w:${width};`}
  aria-label="sidebar"
  aria-hidden="false"
>
  {collapsible && <button type="button" class="sb-close" data-sidebar-close aria-label="Close sidebar">Close</button>}
  {hasHeader && <div class="sb-head"><slot name="header" /></div>}
  <nav class="sb-nav"><slot /></nav>
  {hasFooter && <div class="sb-foot"><slot name="footer" /></div>}
</aside>
<script>
  const input = document.querySelector<HTMLInputElement>('#sb-toggle')
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sidebar-toggle]'))
  if (input && triggers.length > 0) {
    let returnFocus: HTMLElement | null = null
    const mobileQuery = window.matchMedia('(max-width: 767px)')
    const sync = () => {
      const open = input.checked
      document.documentElement.dataset.sidebarOpen = open ? 'true' : 'false'
      const sidebar = document.querySelector<HTMLElement>('#site-sidebar')
      if (sidebar && mobileQuery.matches) {
        sidebar.toggleAttribute('inert', !open)
        sidebar.setAttribute('aria-hidden', String(!open))
        document.body.style.overflow = open ? 'hidden' : ''
      } else if (sidebar) {
        sidebar.removeAttribute('inert')
        sidebar.setAttribute('aria-hidden', 'false')
        document.body.style.overflow = ''
      }
      triggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', String(open))
        trigger.setAttribute('aria-label', open ? 'Close sidebar' : 'Open sidebar')
      })
      if (open) {
        returnFocus = document.activeElement as HTMLElement | null
        const firstLink = document.querySelector<HTMLElement>('#site-sidebar a, #site-sidebar button:not([data-sidebar-close])')
        firstLink?.focus()
      } else {
        returnFocus?.focus()
        returnFocus = null
      }
    }
    const onScrimClick = () => {
      if (!input.checked) return
      input.checked = false
      input.dispatchEvent(new Event('change'))
    }
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && input.checked) {
        input.checked = false
        input.dispatchEvent(new Event('change'))
        return
      }
      if (event.key !== 'Tab' || !input.checked) return
      const focusable = Array.from(
        document.querySelectorAll<HTMLElement>('#site-sidebar a, #site-sidebar button, [data-sidebar-close]'),
      ).filter((element) => !element.hasAttribute('disabled'))
      if (focusable.length === 0) return
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
    input.addEventListener('change', sync)
    const toggleSidebar = () => {
      input.checked = !input.checked
      input.dispatchEvent(new Event('change'))
    }
    triggers.forEach((trigger) => trigger.addEventListener('click', toggleSidebar))
    document.querySelectorAll<HTMLElement>('[data-sidebar-close]').forEach((close) => {
      close.addEventListener('click', onScrimClick)
    })
    document.querySelectorAll<HTMLAnchorElement>('a[href="#sb-toggle"]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault()
        toggleSidebar()
      })
    })
    document.addEventListener('keydown', onKeyDown)
    mobileQuery.addEventListener('change', sync)
    sync()
  }
</script>
<style>
  .sb-toggle { position: absolute; opacity: 0; pointer-events: none; }
  .sb-burger {
    display: none;
    position: fixed;
    top: 112px;
    left: 12px;
    z-index: 60;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    background: var(--paper);
    border: 1px solid var(--rule);
    cursor: pointer;
  }
  .sb-burger span { display: block; width: 20px; height: 2px; background: var(--ink); }
  .sb-burger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sb-scrim {
    display: none;
    border: 0;
    padding: 0;
    background: transparent;
    appearance: none;
  }
  .sb-close { display: none; }
  .site-sidebar {
    width: var(--sb-w, 240px);
    flex: 0 0 var(--sb-w, 240px);
    position: sticky;
    top: 60px;
    align-self: flex-start;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    padding: 16px;
    border-right: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .site-sidebar.is-right { border-right: 0; border-left: 1px solid var(--rule); order: 2; }
  .sb-head { padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .sb-nav { display: flex; flex-direction: column; gap: 4px; }
  .sb-foot { padding-top: 12px; margin-top: 12px; border-top: 1px solid var(--rule); }
  @media (max-width: 767px) {
    .sb-burger { display: inline-flex; }
    .site-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 55;
      transform: translateX(-100%);
      transition: transform 0.2s var(--ease-out, ease);
      max-height: 100vh;
      border-right: 1px solid var(--rule);
      padding-top: 72px;
    }
    .sb-close {
      display: inline-flex;
      align-items: center;
      margin: 0 0 16px auto;
      padding: 6px 8px;
      border: 1px solid var(--rule);
      background: transparent;
      color: var(--ink-mute);
      font: 11px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
    }
    .sb-close:hover { color: var(--accent); border-color: var(--accent); }
    .site-sidebar.is-right { left: auto; right: 0; transform: translateX(100%); }
    .sb-toggle:checked ~ .site-sidebar { transform: translateX(0); }
    .sb-toggle:checked ~ .sb-scrim,
    html[data-sidebar-open='true'] .sb-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 54;
      background: color-mix(in oklab, var(--ink) 45%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-sidebar { transition: none; }
  }
</style>
