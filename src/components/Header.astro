---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — 60px chrome bar (the v2 brief calls for 60px; we honor it).
 *
 * Layout:
 *   ┌─────────────────────────────────────────────────────────────────┐
 *   │  oriz / blog                              ⌘K · rss · ···        │
 *   └─────────────────────────────────────────────────────────────────┘
 *
 * Left:  Wordmark `oriz / blog` in Inter Tight semibold.
 * Center: nothing (intentional).
 * Right: search trigger (⌘K, opens Pagefind in a centered modal),
 *        rss link, ··· overflow with /about /now /series + theme toggle.
 *
 * 60px height. Clean nav, indigo hover/active underline.
 */
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<header class="site-header" transition:persist="site-header">
  <div class="container-page header-inner">
    <div class="brand">
      <Wordmark subtitle="blog" size={22} href="/" />
    </div>
    <nav class="header-nav" aria-label="Primary">
      <a href="/">Latest</a>
      <a href="/series/">Series</a>
      <a href="/tags/">Tags</a>
      <a href="/about/">About</a>
    </nav>
    <div class="header-multisearch">
      <MultiSearch client:idle />
    </div>
    <div class="header-controls-mount">
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }
  .header-nav {
    display: none;
    gap: 1.25rem;
    font-family: var(--font-utility, var(--font-mono));
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .header-nav a {
    position: relative;
    padding-block: 0.25rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast, 120ms) ease;
  }
  .header-nav a:hover {
    color: var(--color-accent);
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast, 120ms) ease;
  }
  .header-nav a:hover::after,
  .header-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header-nav a[aria-current='page'] {
    color: var(--color-accent);
  }
  @media (min-width: 768px) {
    .header-nav { display: inline-flex; align-items: center; }
  }
  .header-controls-mount {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
  .header-multisearch {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
  .header-multisearch + .header-controls-mount {
    margin-left: 0.75rem;
  }
</style>
