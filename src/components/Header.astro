---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — editorial masthead bar ("Signal Press").
 *
 *   ┌─────────────────────────────────────────────────────────────────┐
 *   │  oriz/blog        LATEST · SERIES · TAGS · ABOUT    ⌘K rss ··· │
 *   └─────────────────────────────────────────────────────────────────┘
 *
 * Left: serif wordmark. Center: mono uppercase nav with orange underline.
 * Right: search (⌘K), rss, ··· overflow. 64px, sticky, paper blur.
 */
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<header class="site-header" transition:persist="site-header">
  <div class="container-page header-inner">
    <div class="brand">
      <Wordmark subtitle="blog" size={21} href="/" />
    </div>
    <nav class="header-nav" aria-label="Primary">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Latest</a>
      <a href="/series/" aria-current={Astro.url.pathname.startsWith('/series') ? 'page' : undefined}>Series</a>
      <a href="/tags/" aria-current={Astro.url.pathname.startsWith('/tags') ? 'page' : undefined}>Tags</a>
      <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    </nav>
    <div class="header-multisearch">
      <MultiSearch client:idle />
    </div>
    <div class="header-controls-mount">
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 90%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }
  .header-nav {
    display: none;
    gap: 1.5rem;
    font-family: var(--font-utility, var(--font-mono));
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .header-nav a {
    position: relative;
    padding-block: 0.375rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-fast, 120ms) ease;
  }
  .header-nav a:hover {
    color: var(--color-accent);
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast, 120ms) ease;
  }
  .header-nav a:hover::after,
  .header-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header-nav a[aria-current='page'] {
    color: var(--color-accent);
  }
  @media (min-width: 768px) {
    .header-nav { display: inline-flex; align-items: center; }
  }
  .header-controls-mount {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
  .header-multisearch {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
  .header-multisearch + .header-controls-mount {
    margin-left: 0.75rem;
  }
</style>
