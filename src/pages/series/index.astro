---
/**
 * /series — Browse all blog series (folders).
 *
 * Dynamically detects every multi-part series by scanning for posts whose
 * `id` contains a `/` (i.e. lives inside a subfolder). Groups them by
 * folder, picks the index post's metadata as the series title/description.
 */
import { getCollection } from 'astro:content'
import SeriesSpine from '~/components/SeriesSpine.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { verticalFor, verticalLabel } from '~/lib/blog'

const allPosts = await getCollection('blog', ({ data }) => !data.draft)

const folderMap = new Map<string, typeof allPosts>()
for (const post of allPosts) {
  const slashIndex = post.id.indexOf('/')
  if (slashIndex === -1) continue
  const folder = post.id.substring(0, slashIndex)
  const existing = folderMap.get(folder) ?? []
  existing.push(post)
  folderMap.set(folder, existing)
}

const series = [...folderMap.entries()].map(([folder, posts]) => {
  const indexPost = posts.find((p) => p.id === `${folder}/index`)
  const rep = indexPost ?? posts[0]
  const parts = posts.filter((p) => p.id !== `${folder}/index`)
  const latest = posts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    posts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  return {
    slug: folder,
    title: rep.data.title,
    description: rep.data.description,
    category: rep.data.category,
    vertical: verticalFor(rep.data.category),
    postCount: parts.length,
    total: Math.max(parts.length, explicitMax, parts.length + 1),
    latestDate: latest,
  }
})
series.sort((a, b) => b.latestDate.valueOf() - a.latestDate.valueOf())
---

<BaseLayout title="Series — Blog" description="Browse multi-part blog series.">
  <div class="page">
    <header class="page-head">
      <p class="eyebrow">Running threads</p>
      <h1>Series</h1>
      <p class="meta">{series.length} series — {series.reduce((sum, s) => sum + s.postCount, 0)} posts. Each spine tracks parts published <SeriesSpine total={4} published={2} current={2} size="sm" /> against parts still drafting.</p>
    </header>

    <ul class="series-list">
      {series.map((s) => (
        <li class="series-row" data-vertical={s.vertical}>
          <a class="series-link" href={`/series/${s.slug}/`}>
            <span class="series-kicker mono">
              <span class="series-tick" aria-hidden="true"></span>
              <span class="series-desk">{verticalLabel(s.vertical)}</span>
              <span class="series-parts">{s.postCount} of {s.total} parts</span>
            </span>
            <h3 class="series-title">{s.title}</h3>
            <p class="series-desc">{s.description}</p>
            <span class="series-spine-mount">
              <SeriesSpine total={s.total} published={s.postCount} current={s.postCount} size="md" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 820px; margin-inline: auto; padding: 2.5rem clamp(1rem, 4vw, 1.5rem) 4rem; }
  .page-head { margin-bottom: 0.5rem; border-bottom: 2px solid var(--ink); padding-bottom: 1.25rem; }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem; }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .meta { color: var(--ink-mute); font-size: 0.9375rem; margin: 0.625rem 0 0; display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .series-list { list-style: none; padding: 0; margin: 0; }
  .series-row {
    --v: var(--v-personal);
    border-bottom: 1px solid var(--rule);
  }
  .series-row[data-vertical='dev'] { --v: var(--v-dev); }
  .series-row[data-vertical='finance'] { --v: var(--v-finance); }
  .series-row[data-vertical='culture'] { --v: var(--v-culture); }
  .series-row[data-vertical='health'] { --v: var(--v-health); }
  .series-link {
    display: grid; gap: 0.5rem;
    padding: 1.25rem 0 1.375rem 0.875rem;
    margin-left: -0.875rem;
    border-left: 2px solid transparent;
    color: var(--ink); text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease;
  }
  .series-link:hover { border-left-color: var(--v); }
  .series-kicker { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
  .series-tick { width: 7px; height: 7px; background: var(--v); flex: 0 0 auto; }
  .series-desk { color: var(--v); font-weight: 500; }
  .series-parts { border-left: 1px solid var(--rule); padding-left: 0.5rem; }
  .series-title { font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; margin: 0; }
  .series-link:hover .series-title { color: var(--accent); }
  .series-desc { color: var(--ink-mute); font-size: 0.9375rem; line-height: 1.5; margin: 0; max-width: 62ch; }
  .series-spine-mount { margin-top: 0.25rem; }
</style>
