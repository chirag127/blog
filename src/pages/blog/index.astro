---
import PostCard from '~/components/blog/PostCard.astro'
/**
 * /blog — page 1 of the paginated blog index.
 * Pages 2+ live at /blog/page/[page] (see ./page/[page].astro).
 *
 * Layout: filter strip of every category, then a ruled dispatch ledger.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllCategories, getPublishedPosts, slugifyTag } from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const PAGE_SIZE = 12

const allPosts = await getPublishedPosts()
const categories = await getAllCategories()
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE))
const posts = allPosts.slice(0, PAGE_SIZE)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog — ${SITE_CONFIG.title}`,
  url: new URL('/blog/', SITE_CONFIG.url).toString(),
  description: 'Writing on software, AI agents, finance tooling, and the tools I build at oriz.in.',
  author: {
    '@type': 'Person',
    name: SITE_CONFIG.author.name,
    url: SITE_CONFIG.author.url,
  },
}
---

<BaseLayout
  title="Blog"
  description="Writing on software, AI agents, finance tooling, and the tools I build."
  jsonLd={jsonLd}
>
  <div class="container-page section">
    <header class="blog-head">
      <p class="blog-kicker mono">The desk</p>
      <h1>Blog</h1>
      <p class="blog-lede">
        Writing on software, AI agents, finance tooling, and the tools I build.
      </p>
    </header>

    {categories.length > 0 && (
      <nav class="desk-strip mono" aria-label="Filter posts by category">
        <a class="desk is-active" href="/blog/">All</a>
        {categories.map((c) => (
          <a class="desk" href={`/categories/${slugifyTag(c)}/`}>{c}</a>
        ))}
      </nav>
    )}

    {posts.length === 0 ? (
      <p class="muted">No posts yet — the first one drops shortly.</p>
    ) : (
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    )}

    {totalPages > 1 && (
      <nav class="pager mono" aria-label="Pagination">
        <span class="pager-info">Page 1 of {totalPages}</span>
        <a class="pager-link" href="/blog/page/2/" rel="next">Next →</a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .container-page { max-width: 820px; }
  .blog-head {
    padding-block: clamp(2rem, 5vw, 3rem) 1.25rem;
  }
  .blog-kicker {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .blog-head h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.04;
    margin: 0;
  }
  .blog-lede {
    color: var(--ink-mute);
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0.75rem 0 0;
    max-width: 60ch;
  }
  .desk-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-bottom: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .desk {
    color: var(--ink-mute);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1rem;
  }
  .desk:hover { color: var(--accent); }
  .desk.is-active { color: var(--accent); border-bottom-color: var(--accent); }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list > li:last-child :global(.post-card) {
    border-bottom: 1px solid var(--rule);
  }
  .pager {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 12px;
  }
  .pager-info {
    color: var(--ink-mute);
    letter-spacing: 0.06em;
  }
  .pager-link {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--rule);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    text-decoration: none;
    color: var(--ink);
  }
  .pager-link:hover { border-color: var(--accent); color: var(--accent); }
  .muted { color: var(--ink-mute); }
  .section { padding-block: 0 3rem; }
</style>
