---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'

const allPosts = await getCollection('blog', ({ data }) => !data.draft)
const tagMap = new Map<string, number>()

for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1)
  }
}

const sortedTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1])

function slugifyTag(value: string): string {
  return value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
}
---

<BaseLayout title="Tags — Blog" description="Browse blog posts by tag.">
  <div class="page">
    <header class="page-head">
      <p class="eyebrow mono">Index / vocabulary</p>
      <h1>Tags</h1>
      <p class="meta">{sortedTags.length} tag{sortedTags.length !== 1 ? 's' : ''} across {allPosts.length} posts.</p>
    </header>

    <ul class="tag-cloud">
      {sortedTags.map(([tag, count]) => (
        <li>
          <a class="tag-chip" href={`/tags/${slugifyTag(tag)}/`}>
            <span>#{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { padding-block: 2.5rem 4rem; }
  .page-head { margin-bottom: 1.5rem; }
  .eyebrow { margin: 0 0 0.75rem; color: var(--accent); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .meta { color: var(--ink-mute); font-size: 0.9375rem; margin: 0.625rem 0 0; }
  .tag-cloud { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; border-top: 1px solid var(--rule); padding-top: 1rem; }
  .tag-chip { display: inline-flex; align-items: baseline; gap: 0.375rem; padding: 0.375rem 0; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; }
  .tag-chip:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .tag-count { color: var(--ink-mute); font-family: var(--font-mono); font-size: 11px; }
</style>
